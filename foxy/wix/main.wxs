<?xml version='1.0' encoding='utf-8'?>
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='foxyXplorer'
        UpgradeCode='A3FA8115-A5AE-433E-B7AE-F587D5689C3B'
        Manufacturer='Grant Borodin'
        Language='1033'
        Codepage='65001'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Manufacturer='Grant Borodin'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            Codepage='65001'
            SummaryCodepage='1251'
            />
        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='foxyXplorer Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="FoxyXplorer"/>
            </Directory>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='foxyXplorer'>
                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='87740A4E-DB11-431D-ABF8-3245F27732CA' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='foxyXplorer.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\foxyXplorer.exe'
                                KeyPath='yes'/>
                            <Shortcut Id="ApplicationStartMenuShortcut"
                                      Name="FoxyXplorer"
                                      Description="Картографическое приложение для локальных задач"
                                      Target="[Bin]foxyXplorer.exe"
                                      WorkingDirectory="Bin"/>
                            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Icon Id='ProductICO' SourceFile='wix\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <UI>
            <UIRef Id='WixUI_InstallDir'/>
        </UI>

    </Product>

</Wix>
